# HIST-14 · Plantilla de variables del staging. En el droplet:
#   cp deploy/staging/env.example .env.staging && chmod 600 .env.staging
# .env.staging nunca se sube al repo (.gitignore: .env*). No reutilices ninguna
# llave de producción ni de .env.local.

# --- Dominios (registros A hacia la IP del droplet)
STAGING_DOMAIN=staging.ejemplo.com
STAGING_MAIL_DOMAIN=correo-staging.ejemplo.com
APP_URL=https://staging.ejemplo.com
PUBLIC_APP_URL=https://staging.ejemplo.com
NEXT_PUBLIC_SITE_URL=https://staging.ejemplo.com

# --- Proyecto de Supabase EXCLUSIVO de staging (Project Settings → API)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel /administracion: credenciales propias del staging
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=

# --- Buzón de pruebas (Mailpit). El usuario/contraseña SMTP son los que se
# escriben en Supabase → Authentication → SMTP; los de UI se dan a los testers.
MAILPIT_UI_USER=
MAILPIT_UI_PASSWORD=
MAILPIT_SMTP_USER=
MAILPIT_SMTP_PASSWORD=

# --- Vencimientos (cron del droplet → /api/cron/suscripciones)
CRON_SECRET=

# --- Reglas de registro: "false" deja a los testers usar correos @gmail/@hotmail
REGLA_B2B_ACTIVA=false

# --- Integraciones externas: apagadas en staging. WhatsApp manda mensajes
# reales y la IA consume créditos; solo se llenan con autorización del owner.
WHATSAPP_PROVIDER=meta
WHATSAPP_ALERTAS_ACTIVAS=false
WHATSAPP_APROBACIONES_ACTIVAS=false
WHATSAPP_META_USE_TEMPLATES=false
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_FINANZAS_PROVIDER=gemini
AI_OPERACIONES_PROVIDER=gemini
RESEND_API_KEY=
