{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",

  "cleanUrls": true,

  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "memory": 512
    },
    "api/ia/resumen.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    }
  ]
}
