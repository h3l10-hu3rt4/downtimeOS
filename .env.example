# =============================================================================
# DowntimeOS · Variables de entorno
# =============================================================================
# Copia este archivo como `.env.local` para desarrollo con `vercel dev`, y
# registra las mismas variables en:
#   Vercel → Project → Settings → Environment Variables
#
# ⚠️ .env.local NUNCA se sube al repo (ver .gitignore).
# =============================================================================

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → service_role (SECRET)
# Omite Row Level Security. Solo servidor. Si se filtra, rota la llave de
# inmediato desde el dashboard de Supabase.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Opcional: pon "false" para aceptar correos @gmail/@hotmail en una demo.
# Cualquier otro valor (o ausencia) mantiene la regla B2B activa.
REGLA_B2B_ACTIVA=true
