# =============================================================================
# DowntimeOS · Variables de entorno
# =============================================================================
# Copia este archivo como `.env.local` para desarrollo con `vercel dev`, y
# registra las mismas variables en:
#   Vercel → Project → Settings → Environment Variables
#
# ⚠️ .env.local NUNCA se sube al repo (ver .gitignore).
# =============================================================================

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → service_role (SECRET)
# Omite Row Level Security. Solo servidor. Si se filtra, rota la llave de
# inmediato desde el dashboard de Supabase.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Opcional: pon "false" para aceptar correos @gmail/@hotmail en una demo.
# Cualquier otro valor (o ausencia) mantiene la regla B2B activa.
REGLA_B2B_ACTIVA=true

# Administración privada (/administracion). Nunca incluyas estas credenciales
# en archivos dentro de public/ ni en usuarios.js.
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=

# Gemini: análisis financiero del tablero. Nunca se expone al navegador.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Proveedores de IA por área. Las claves solo se leen en las funciones serverless.
AI_FINANZAS_PROVIDER=gemini
AI_OPERACIONES_PROVIDER=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# URL pública del despliegue, necesaria para callbacks.
PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# WhatsApp: Meta Cloud API es el canal del pitch. El destino puede ser una lista separada por comas.
WHATSAPP_PROVIDER=meta
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_VERSION=v23.0
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_WEBHOOK_SECRET=
META_WHATSAPP_TEMPLATE_LANGUAGE=es_MX
META_WHATSAPP_TEMPLATE_PAROS=downtimeos_alerta_paros
META_WHATSAPP_TEMPLATE_ALERTA_ACTIVO=downtimeos_alerta_activo
META_WHATSAPP_TEMPLATE_REPORTE=downtimeos_reporte_ejecutivo
META_WHATSAPP_TEMPLATE_APROBACION=downtimeos_validacion_paro
WHATSAPP_APROBACIONES_ACTIVAS=false
# Actívala únicamente cuando las cuatro plantillas de Meta estén aprobadas.
# Mientras sea false, local y producción usan mensajes normales durante las
# 24 horas posteriores a un mensaje recibido del destinatario.
WHATSAPP_META_USE_TEMPLATES=false
# Respaldo opcional para PDF si Gemini responde 503. Deja vacío en producción
# salvo que se quiera habilitar explícitamente.
AI_REPORTE_FALLBACK_PROVIDER=
AI_REPORTE_PROVIDER=

# Twilio queda como respaldo opcional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=14155238886
WHATSAPP_ALERTAS_DESTINATARIOS=5215551234567
# Operaciones recibe paros y validaciones; Finanzas recibe reportes ejecutivos.
# Si se omiten, se usa el destinatario legado de arriba.
WHATSAPP_OPERACIONES_DESTINATARIO=
WHATSAPP_FINANZAS_DESTINATARIO=
WHATSAPP_ALERTAS_ACTIVAS=false
